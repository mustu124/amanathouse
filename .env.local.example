# Copy this file to .env.local and fill in real values.
# See docs/ENV_SETUP.md for what each variable does and where to set it in Vercel.

# ── Supabase ──────────────────────────────────────────────────────────
# Project URL — Supabase Dashboard > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/public key — Supabase Dashboard > Project Settings > API > Project API keys > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — Supabase Dashboard > Project Settings > API > Project API keys > service_role
# SERVER-ONLY: no NEXT_PUBLIC_ prefix. Never import lib/supabase.ts from a "use client" file.
# Also doubles as the admin-panel auth backend (see "Admin auth" below).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Public storage bucket name — create this bucket in Supabase Dashboard > Storage
SUPABASE_STORAGE_BUCKET=amanat-house

# ── Admin auth ────────────────────────────────────────────────────────
# The admin panel (/admin) has no separate auth env vars of its own — it signs in
# through Supabase Auth using NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY
# above, and the session is verified server-side with SUPABASE_SERVICE_ROLE_KEY.
# Create admin users in Supabase Dashboard > Authentication > Users (email + password).

# ── Site ──────────────────────────────────────────────────────────────
# Canonical production URL — used for SEO metadataBase/OpenGraph. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.amanathouse.com

# ── Contact / storefront ────────────────────────────────────────────────
# WhatsApp number orders and enquiries are sent to. Digits only, country code first,
# e.g. 919999999999 for an Indian number with no +, spaces, or dashes.
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999

# Store contact email shown on the contact page and used as the settings fallback.
NEXT_PUBLIC_STORE_EMAIL=hello@amanathouse.com

# Instagram profile URL shown in the footer/nav and used as the settings fallback.
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/amanathouse

# Optional. City/address shown on the contact page, footer, and structured data.
# Leave unset to show a visible "TODO: confirm city" placeholder instead of a guess.
NEXT_PUBLIC_STORE_ADDRESS=
